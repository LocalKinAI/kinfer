+//
+// clock keep-warm
+//
+// macOS lowers an idle GPU's clock within milliseconds. A GPU that waits between graphs pays for
+// it on the next one: with a model split across an M3 Ultra and an M5 Max, each waiting while the
+// other computes, the same 8 layers went from 6 ms to 11-14 ms a token over a reply's first 20
+// tokens, and keeping both GPUs busy took decode from 25 to 38 tok/s. For a window after each
+// graph computation a background thread runs a tiny kernel (one SIMD group, about 50 us) back to
+// back on a queue of its own; when the window passes without another graph, it sleeps.
+//
+
+#define GGML_METAL_WARM_KERNEL_US 50.0
+
+static atomic_int g_metal_warm_ms = -1; // -1: GGML_METAL_WARM_MS not read yet
+
+static int ggml_metal_warm_ms(void) {
+    int ms = atomic_load_explicit(&g_metal_warm_ms, memory_order_relaxed);
+    if (ms < 0) {
+        const char * val = getenv("GGML_METAL_WARM_MS");
+        int expected = -1;
+        atomic_compare_exchange_strong(&g_metal_warm_ms, &expected, val ? MAX(0, atoi(val)) : 0);
+        ms = atomic_load_explicit(&g_metal_warm_ms, memory_order_relaxed);
+    }
+    return ms;
+}
+
+void ggml_metal_set_warm_ms(int window_ms) {
+    atomic_store_explicit(&g_metal_warm_ms, MAX(0, window_ms), memory_order_relaxed);
+}
+
+struct ggml_metal_warm {
+    id<MTLCommandQueue>         queue;
+    id<MTLComputePipelineState> pipeline;
+    id<MTLBuffer>               out;
+
+    atomic_llong until_ns; // keep warm until this uptime
+    atomic_bool  sleeping;
+    atomic_bool  stop;
+
+    dispatch_semaphore_t wake;
+    dispatch_group_t     group;
+};
+
+static const char * ggml_metal_warm_src =
+    "#include <metal_stdlib>\n"
+    "using namespace metal;\n"
+    "kernel void kernel_warm(device uint * out [[buffer(0)]], constant uint & n [[buffer(1)]], uint tid [[thread_position_in_grid]]) {\n"
+    "    uint x = tid;\n"
+    "    for (uint i = 0; i < n; ++i) { x = x*1664525u + 1013904223u; }\n"
+    "    out[tid] = x;\n"
+    "}\n";
+
+static long long ggml_metal_uptime_ns(void) {
+    return (long long) clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+static struct ggml_metal_warm * ggml_metal_warm_init(id<MTLDevice> device) {
+    NSError * error = nil;
+
+    id<MTLLibrary> lib = [device newLibraryWithSource:[NSString stringWithUTF8String:ggml_metal_warm_src] options:nil error:&error];
+    if (lib == nil) {
+        GGML_LOG_WARN("%s: cannot compile the keep-warm kernel: %s\n", __func__, [[error localizedDescription] UTF8String]);
+        return NULL;
+    }
+    id<MTLFunction> fn = [lib newFunctionWithName:@"kernel_warm"];
+    id<MTLComputePipelineState> pipeline = [device newComputePipelineStateWithFunction:fn error:&error];
+    [fn release];
+    [lib release];
+    if (pipeline == nil) {
+        GGML_LOG_WARN("%s: cannot make the keep-warm pipeline: %s\n", __func__, [[error localizedDescription] UTF8String]);
+        return NULL;
+    }
+
+    struct ggml_metal_warm * w = calloc(1, sizeof(struct ggml_metal_warm));
+    w->queue    = [device newCommandQueue];
+    w->pipeline = pipeline;
+    w->out      = [device newBufferWithLength:32*sizeof(uint32_t) options:MTLResourceStorageModePrivate];
+    atomic_store_explicit(&w->until_ns, 0, memory_order_relaxed);
+    atomic_store_explicit(&w->sleeping, false, memory_order_relaxed);
+    atomic_store_explicit(&w->stop, false, memory_order_relaxed);
+    w->wake  = dispatch_semaphore_create(0);
+    w->group = dispatch_group_create();
+
+    dispatch_group_async(w->group, dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        uint32_t n = 256; // loop count, tuned as it runs to keep each kernel near GGML_METAL_WARM_KERNEL_US
+        while (!atomic_load_explicit(&w->stop, memory_order_relaxed)) {
+            if (ggml_metal_uptime_ns() >= atomic_load_explicit(&w->until_ns, memory_order_relaxed)) {
+                // announce the sleep before the last look at the window, so a graph that arrives in
+                // between either moves the window or finds the flag and wakes the thread
+                atomic_store_explicit(&w->sleeping, true, memory_order_seq_cst);
+                if (ggml_metal_uptime_ns() >= atomic_load_explicit(&w->until_ns, memory_order_seq_cst) &&
+                    !atomic_load_explicit(&w->stop, memory_order_relaxed)) {
+                    dispatch_semaphore_wait(w->wake, DISPATCH_TIME_FOREVER);
+                }
+                atomic_store_explicit(&w->sleeping, false, memory_order_relaxed);
+                continue;
+            }
+            @autoreleasepool {
+                id<MTLCommandBuffer> cmd_buf = [w->queue commandBuffer];
+                id<MTLComputeCommandEncoder> encoder = [cmd_buf computeCommandEncoder];
+                [encoder setComputePipelineState:w->pipeline];
+                [encoder setBuffer:w->out offset:0 atIndex:0];
+                [encoder setBytes:&n length:sizeof(n) atIndex:1];
+                [encoder dispatchThreads:MTLSizeMake(32, 1, 1) threadsPerThreadgroup:MTLSizeMake(32, 1, 1)];
+                [encoder endEncoding];
+                [cmd_buf commit];
+                [cmd_buf waitUntilCompleted];
+
+                const double us = ([cmd_buf GPUEndTime] - [cmd_buf GPUStartTime])*1e6;
+                if (us > 0) {
+                    n = (uint32_t) MAX(64.0, MIN(16777216.0, n*GGML_METAL_WARM_KERNEL_US/us));
+                }
+            }
+        }
+    });
+
+    return w;
+}
+
+static void ggml_metal_warm_free(struct ggml_metal_warm * w) {
+    if (w == NULL) {
+        return;
+    }
+
+    atomic_store_explicit(&w->stop, true, memory_order_seq_cst);
+    dispatch_semaphore_signal(w->wake);
+    dispatch_group_wait(w->group, DISPATCH_TIME_FOREVER);
+    dispatch_release(w->group);
+    dispatch_release(w->wake);
+
+    [w->out release];
+    [w->pipeline release];
+    [w->queue release];
+
+    free(w);
+}
+
+void ggml_metal_device_warm(ggml_metal_device_t dev) {
+    const int ms = ggml_metal_warm_ms();
+    if (ms <= 0) {
+        return;
+    }
+
+    struct ggml_metal_warm * w = atomic_load_explicit(&dev->warm, memory_order_acquire);
+    if (w == NULL) {
+        @synchronized (dev->mtl_device) {
+            w = atomic_load_explicit(&dev->warm, memory_order_acquire);
+            if (w == NULL && !dev->warm_failed) {
+                w = ggml_metal_warm_init(dev->mtl_device);
+                dev->warm_failed = w == NULL;
+                atomic_store_explicit(&dev->warm, w, memory_order_release);
+            }
+        }
+        if (w == NULL) {
+            return;
+        }
+    }
+
+    atomic_store_explicit(&w->until_ns, ggml_metal_uptime_ns() + (long long) ms*1000000, memory_order_seq_cst);
+    if (atomic_exchange_explicit(&w->sleeping, false, memory_order_seq_cst)) {
+        dispatch_semaphore_signal(w->wake);
+    }
+}
