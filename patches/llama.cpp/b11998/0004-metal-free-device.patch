+// The GPU memory every process on the machine holds, from the accelerator's own statistics
+// (IOAccelerator's PerformanceStatistics, "Alloc system memory"), or 0 when they cannot be read.
+static size_t ggml_metal_device_alloc_all(void) {
+    size_t all = 0;
+#if TARGET_OS_OSX
+    io_service_t accel = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("IOAccelerator"));
+    if (accel == IO_OBJECT_NULL) {
+        return 0;
+    }
+    CFTypeRef stats = IORegistryEntryCreateCFProperty(accel, CFSTR("PerformanceStatistics"), kCFAllocatorDefault, 0);
+    if (stats != NULL && CFGetTypeID(stats) == CFDictionaryGetTypeID()) {
+        CFTypeRef v = CFDictionaryGetValue((CFDictionaryRef) stats, CFSTR("Alloc system memory"));
+        int64_t n = 0;
+        if (v != NULL && CFGetTypeID(v) == CFNumberGetTypeID() && CFNumberGetValue((CFNumberRef) v, kCFNumberSInt64Type, &n) && n > 0) {
+            all = (size_t) n;
+        }
+    }
+    if (stats != NULL) {
+        CFRelease(stats);
+    }
+    IOObjectRelease(accel);
+#endif
+    return all;
 }
 
+// GGML_METAL_FREE_DEVICE: report free memory as what the whole GPU has left, not this process's
+// share of it. Metal counts a process's own allocations only, so a process that lends its GPU to
+// another machine (kinfer worker) would offer memory the machine's other apps already hold, and the
+// layers it is given would be paged in and out of the GPU every token.
+static bool ggml_metal_free_device(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char * val = getenv("GGML_METAL_FREE_DEVICE");
+        on = val != NULL && val[0] != '\0' && strcmp(val, "0") != 0;
+    }
+    return on;
+}
