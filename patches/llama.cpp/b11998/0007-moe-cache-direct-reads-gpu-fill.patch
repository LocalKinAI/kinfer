+                tm.read/nl, tm.upload/nl, tm.map/nl, tm.ahead/nl);
+            LLAMA_LOG_INFO("llama_moe_cache: timing, generation: ms a token over its cached layers: between layers %.2f, waiting for the GPU %.2f, "
+                "selection and plan %.2f, reading misses %.2f, uploading %.2f, slot map %.2f, read-ahead %.2f; the GPU busy %.2f of it\n",
+                tm.between/tm.n_tokens, tm.sync/tm.n_tokens, tm.plan/tm.n_tokens, tm.read/tm.n_tokens, tm.upload/tm.n_tokens,
+                tm.map/tm.n_tokens, tm.ahead/tm.n_tokens, tm.gpu/tm.n_tokens);
+            if (tm.guess_n > 0) {
+                LLAMA_LOG_INFO("llama_moe_cache: timing, read-ahead: %llu guesses, each started %.3f ms after its callback and took %.3f ms "
+                    "(the router on the host and queueing the reads)\n", (unsigned long long) tm.guess_n.load(),
+                    tm.guess_wait_ns/1e6/tm.guess_n, tm.guess_ns/1e6/tm.guess_n);
+            }
+            std::string line;
+            int n_line = 0;
+            for (size_t il = 0; il < tm.hits.size(); ++il) {
+                const size_t n = tm.hits[il] + tm.misses[il];
+                if (n == 0) {
+                    continue;
+                }
+                char buf[96];
+                snprintf(buf, sizeof(buf), " %zu:%.0f/%.0f/%.0f", il, 100.0*tm.hits[il]/n,
+                    tm.misses[il] ? 100.0*tm.misses_ahead[il]/tm.misses[il] : 0.0,
+                    tm.compared[il] ? 100.0*tm.same[il]/tm.compared[il] : 0.0);
+                line += buf;
+                if (++n_line % 10 == 0) {
+                    LLAMA_LOG_INFO("llama_moe_cache: per layer, hit%%/misses read ahead%%/same as the previous token%%:%s\n", line.c_str());
+                    line.clear();
+                }
+            }
+            if (!line.empty()) {
+                LLAMA_LOG_INFO("llama_moe_cache: per layer, hit%%/misses read ahead%%/same as the previous token%%:%s\n", line.c_str());
+            }
         }
     }
 };
