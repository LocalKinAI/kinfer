+
+// a GPU that sits idle between two graphs while the host works runs the next one slower, its clock let down: keep
+// it busy with one small kernel for about us microseconds, on the queue the graphs use, so the kernel runs after
+// the graph before and ahead of the next one instead of beside them
+static const char * ggml_metal_fill_src =
+    "#include <metal_stdlib>\n"
+    "using namespace metal;\n"
+    "kernel void kernel_fill(device uint * out [[buffer(0)]], constant uint & n [[buffer(1)]], uint tid [[thread_position_in_grid]]) {\n"
+    "    uint x = tid;\n"
+    "    for (uint i = 0; i < n; ++i) { x = x*1664525u + 1013904223u; }\n"
+    "    out[tid] = x;\n"
+    "}\n";
+
+static id<MTLComputePipelineState> g_fill_pipeline;
+static id<MTLBuffer>               g_fill_out;
+static _Atomic double              g_fill_per_us = 300.0; // loop iterations a microsecond, learnt as it runs
+
+void ggml_metal_fill(ggml_metal_t ctx, int us) {
+    if (us <= 0) {
+        return;
+    }
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        id<MTLDevice> device = ggml_metal_device_get_obj(ctx->dev);
+        NSError * error = nil;
+        id<MTLLibrary> lib = [device newLibraryWithSource:[NSString stringWithUTF8String:ggml_metal_fill_src] options:nil error:&error];
+        if (lib == nil) {
+            GGML_LOG_WARN("%s: cannot compile the fill kernel: %s\n", __func__, [[error localizedDescription] UTF8String]);
+            return;
+        }
+        id<MTLFunction> fn = [lib newFunctionWithName:@"kernel_fill"];
+        g_fill_pipeline = [device newComputePipelineStateWithFunction:fn error:&error];
+        [fn release];
+        [lib release];
+        g_fill_out = [device newBufferWithLength:32*sizeof(uint32_t) options:MTLResourceStorageModePrivate];
+    });
+    if (g_fill_pipeline == nil) {
+        return;
+    }
+    const double per_us = atomic_load(&g_fill_per_us);
+    const uint32_t n = (uint32_t) MAX(64.0, MIN(16777216.0, per_us*us));
+    @autoreleasepool {
+        id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+        id<MTLCommandBuffer> cmd_buf = [queue commandBufferWithUnretainedReferences];
+        id<MTLComputeCommandEncoder> encoder = [cmd_buf computeCommandEncoder];
+        [encoder setComputePipelineState:g_fill_pipeline];
+        [encoder setBuffer:g_fill_out offset:0 atIndex:0];
+        [encoder setBytes:&n length:sizeof(n) atIndex:1];
+        [encoder dispatchThreads:MTLSizeMake(32, 1, 1) threadsPerThreadgroup:MTLSizeMake(32, 1, 1)];
+        [encoder endEncoding];
+        [cmd_buf addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+            const double t = (cb.GPUEndTime - cb.GPUStartTime)*1e6;
+            if (t > 1.0) {
+                atomic_store(&g_fill_per_us, 0.8*atomic_load(&g_fill_per_us) + 0.2*(n/t));
+                atomic_fetch_add(&g_fill_ns, (uint64_t) (t*1e3));
+            }
+            atomic_fetch_add(&g_fill_n, 1);
+        }];
+        [cmd_buf commit];
+    }
+}
