+static bool moe_cache_read_f32(const ggml_tensor * t, std::vector<float> & out) {
+    const ggml_tensor * tb = t->view_src ? t->view_src : t;
+    if (tb->buffer == nullptr || t->data == nullptr || !ggml_is_contiguous(t)) {
+        return false;
+    }
+    const int64_t n = ggml_nelements(t);
+    out.resize(n);
+    if (t->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_get(t, out.data(), 0, ggml_nbytes(t));
+        return true;
+    }
+    const auto * traits = ggml_get_type_traits(t->type);
+    if (traits->to_float == nullptr) {
+        return false;
+    }
+    std::vector<uint8_t> raw(ggml_nbytes(t));
+    ggml_backend_tensor_get(t, raw.data(), 0, raw.size());
+    traits->to_float(raw.data(), out.data(), n);
+    return true;
+}
+
+// the input of the router of a layer: walk up from the selected experts to the matmul with the router weights
+static const ggml_tensor * moe_cache_router_input(const ggml_tensor * sel, const ggml_tensor * gate_inp) {
+    std::vector<const ggml_tensor *> stack = { sel };
+    for (int n = 0; !stack.empty() && n < 64; ++n) {
+        const ggml_tensor * t = stack.back();
+        stack.pop_back();
+        if (t->op == GGML_OP_MUL_MAT && t->src[0] == gate_inp) {
+            return t->src[1];
+        }
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            if (t->src[i] != nullptr) {
+                stack.push_back(t->src[i]);
+            }
+        }
+        if (t->view_src != nullptr) {
+            stack.push_back(t->view_src);
+        }
+    }
+    return nullptr;
+}
