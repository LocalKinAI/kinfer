+// the router of a cached layer on the host, to guess from the input of one layer which experts the next one selects
+struct moe_cache_router {
+    const ggml_tensor * gate_inp = nullptr;
+    int64_t n_embd = 0;
+    std::vector<float> w;     // [n_expert][n_embd]
+    std::vector<float> b;     // [n_expert] logit bias, empty if none
+    std::vector<float> sel_b; // [n_expert] selection bias, empty if none
