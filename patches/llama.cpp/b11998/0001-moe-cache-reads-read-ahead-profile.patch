+// pages in host experts before they are uploaded
+// experts mapped from a file are read one page fault at a time when the upload copies them, so the kernel is asked
+// for all of them at once and a pool of threads touches their pages until they are in; experts guessed for the next
+// layer are only asked for, and arrive while the device computes
+struct moe_cache_reader {
+    static constexpr size_t chunk = 64*1024;
+    static constexpr size_t page  = 4096;
+
+    struct range {
+        const uint8_t * data;
+        size_t size;
+    };
+
+    struct job {
+        range r;
+        bool now;
+        std::function<void()> fn; // runs instead of reading r
+    };
