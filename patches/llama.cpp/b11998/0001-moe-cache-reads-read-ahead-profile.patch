+void llama_moe_cache_read(const std::vector<llama_moe_read> & reads, bool nocache) {
+    // shared by every context and never freed: it holds no state of theirs, and threads still waiting at exit are harmless
+    static moe_cache_reader * reader = [] {
+        auto * r = new moe_cache_reader();
+        r->start(std::clamp((int) std::thread::hardware_concurrency(), 4, 16));
+        return r;
+    }();
+    std::vector<moe_cache_reader::read> rs;
+    rs.reserve(reads.size());
+    for (const llama_moe_read & r : reads) {
+        rs.push_back({ (const uint8_t *) r.src, r.size, (uint8_t *) r.dst });
+    }
+    reader->read_now(rs, nocache);
+}
