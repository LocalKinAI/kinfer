+    bool read_profile(const char * path, std::vector<float> & out) const {
+        FILE * f = std::fopen(path, "rb");
+        if (f == nullptr) {
+            return false;
+        }
+        char magic[8];
+        uint32_t n_layer  = 0;
+        uint32_t n_expert = 0;
+        bool ok = std::fread(magic, 1, sizeof(magic), f) == sizeof(magic) && std::memcmp(magic, profile_magic, sizeof(magic)) == 0 &&
+            std::fread(&n_layer, sizeof(n_layer), 1, f) == 1 && std::fread(&n_expert, sizeof(n_expert), 1, f) == 1 &&
+            n_layer == layers.size() && n_expert == (uint32_t) n_expert_model;
+        if (ok) {
+            out.resize((size_t) n_layer*n_expert);
+            ok = std::fread(out.data(), sizeof(float), out.size(), f) == out.size();
+        }
+        std::fclose(f);
+        return ok;
+    }
