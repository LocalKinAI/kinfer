+            }
+            for (int32_t e = 0; e < n_exp; ++e) {
+                idx[e] = e;
+            }
+            std::partial_sort(idx.begin(), idx.begin() + k, idx.end(), [&](int32_t a, int32_t b) { return s[a] > s[b]; });
+            for (int32_t i = 0; i < k; ++i) {
+                want[idx[i]] = 1;
+            }
+        }
+
+        std::vector<moe_cache_reader::range> rs;
+        size_t n_read = 0;
+        for (int32_t e = 0; e < n_exp; ++e) {
+            if (!want[e] || slots[e] >= 0) {
+                want[e] = 0;
+                continue;
+            }
+            n_read++;
+            for (const ggml_tensor * w : layers[il].experts) {
+                rs.push_back({ (const uint8_t *) w->data + (size_t) e*w->nb[2], w->nb[2] });
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(ahead_mutex);
+            ahead_set[il] = std::move(want);
+            st_read.read_ahead += n_read;
+        }
+        reader.ahead(rs);
+    }
