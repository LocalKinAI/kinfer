+
+struct llama_moe_stream::impl {
+    static constexpr size_t align = 16384;
+    static constexpr size_t chunk = moe_cache_reader::chunk;
+
+    // host memory a weight is read into, laid out like the weight from a 16 KiB boundary on, past the offset of the
+    // weight within its page: the offset the file has it at, so the aligned middle of a read goes straight from the SSD
+    struct slot {
+        const ggml_tensor *  t = nullptr;
+        std::vector<uint8_t> buf;
+        uint8_t *            base = nullptr;
+        std::vector<uint8_t> staged;      // [n_expert] experts read, or being read, into it
+        size_t               pending = 0; // requests still being read into it, under mutex
+        uint64_t             used    = 0; // when it was last uploaded from
+
+        uint8_t * at(size_t offset) const {
+            return base + (uintptr_t) t->data % align + offset;
+        }
+    };
+
+    struct stats {
+        size_t n_uploads  = 0;
+        size_t read_now   = 0; // bytes read when the upload needed them
+        size_t read_ahead = 0; // bytes read ahead of the upload
+        size_t copied     = 0; // bytes written to the device
+        size_t cached     = 0; // of which copied from the cache
+        double wait_ms    = 0.0;
+        double copy_ms    = 0.0;
+    };
+
+    const llama_moe_cache * cache;
+    const size_t slot_size;
+
+    std::vector<slot> slots;
+    std::vector<const ggml_tensor *> order; // host weights in the order of their last copies for large batches
+    size_t   pos   = 0;
+    uint64_t clock = 0;
+
+    // the experts the last upload of each weight used, which the next one reads ahead
+    std::unordered_map<const ggml_tensor *, std::vector<uint8_t>> last;
+
+    std::vector<moe_cache_reader::read> reads;
+    std::vector<std::function<void()>>  fns;
+    ggml_context_ptr ctx_views; // of the copies from the cache
+    size_t n_views = 0;
+
+    std::mutex mutex; // pending
+    std::condition_variable cv;
+    stats st;
+
+    // last, so their threads stop before what they use goes away; the copies have threads of their own, which the
+    // reads queued ahead would otherwise keep busy
+    moe_cache_reader reader;
+    moe_cache_reader copier;
+
+    impl(const llama_moe_cache * cache, const std::vector<const ggml_tensor *> & weights, size_t max_weight, int n_slots) :
+            cache(cache), slot_size(align + max_weight), slots(std::max(n_slots, 2)), order(weights), pos(weights.empty() ? 0 : weights.size() - 1) {
+        const int n_threads = std::clamp((int) std::thread::hardware_concurrency(), 4, 16);
+        reader.start(n_threads);
+        copier.start(n_threads);
+    }
+
+    ~impl() {
+        reader.shutdown();
+        copier.shutdown();
+        if (st.n_uploads > 0) {
+            LLAMA_LOG_INFO("llama_moe_stream: %zu uploads of %.2f GiB (%.2f GiB from the cache) in %.1f s; %.2f GiB read ahead and %.2f GiB when needed, waited for %.1f s\n",
+                st.n_uploads, st.copied/1024.0/1024.0/1024.0, st.cached/1024.0/1024.0/1024.0, st.copy_ms/1000.0,
+                st.read_ahead/1024.0/1024.0/1024.0, st.read_now/1024.0/1024.0/1024.0, st.wait_ms/1000.0);
+        }
+    }
+
+    void wait(slot & s) {
+        std::unique_lock<std::mutex> lock(mutex);
+        cv.wait(lock, [&] { return s.pending == 0; });
+    }
+
+    // the slot holding t, or the one used longest ago of those not holding a weight in keep, emptied for t
+    slot & take(const ggml_tensor * t, const std::vector<const ggml_tensor *> & keep) {
+        for (slot & s : slots) {
+            if (s.t == t) {
+                return s;
+            }
+        }
+        slot * victim = nullptr;
+        for (slot & s : slots) {
+            if (s.t != nullptr && std::find(keep.begin(), keep.end(), s.t) != keep.end()) {
+                continue;
+            }
+            if (victim == nullptr || s.used < victim->used) {
+                victim = &s;
+            }
+        }
+        GGML_ASSERT(victim != nullptr);
+        wait(*victim);
+        victim->t    = t;
+        victim->base = moe_cache_stage(victim->buf, std::max(slot_size, align + ggml_nbytes(t)));
+        victim->staged.assign(t->ne[2], 0);
+        return *victim;
+    }
+
+    // read the experts of the weight in s that its last upload used, or all of them, in the background, but for those in
+    // the cache
+    void read_ahead(ggml_backend_t backend, slot & s) {
+        const ggml_tensor * t = s.t;
+        const size_t  expert_size = t->nb[2];
+        const int64_t n_expert    = t->ne[2];
+        const auto it = last.find(t);
+        const std::vector<uint8_t> * want = it != last.end() ? &it->second : nullptr;
+        reads.clear();
+        size_t bytes = 0;
+        auto skip = [&](int64_t e) {
+            return s.staged[e] || (want != nullptr && !(*want)[e]) || (cache != nullptr && cache->cached(backend, t, e));
+        };
+        for (int64_t e = 0; e < n_expert; ) {
+            if (skip(e)) {
+                e++;
+                continue;
+            }
+            int64_t n = 0;
+            while (e + n < n_expert && !skip(e + n)) {
+                s.staged[e + n] = 1;
+                n++;
+            }
+            reads.push_back({ (const uint8_t *) t->data + e*expert_size, n*expert_size, s.at(e*expert_size) });
+            bytes += n*expert_size;
+            e += n;
+        }
+        if (reads.empty()) {
+            return;
+        }
+        // the requests are counted under the lock their completions take
+        std::lock_guard<std::mutex> lock(mutex);
+        s.pending += reader.queue(reads, true, [this, &s] {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (--s.pending == 0) {
+                cv.notify_all();
+            }
+        });
+        st.read_ahead += bytes;
+    }
+
+    void upload(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, const std::vector<llama_moe_upload> & ups,
+            const std::vector<llama_moe_cached> & cached, bool ahead) {
+        // the order the copies come in, as the copies themselves have it: src goes after the last one, wherever it was
+        size_t want = order.empty() ? 0 : pos + 1;
+        if (want == order.size() && !order.empty() && order[0] == src) {
+            want = 0; // the next batch
+        } else if (want == order.size() || order[want] != src) {
+            const auto it = std::find(order.begin(), order.end(), src);
+            if (it != order.end()) {
+                const size_t j = it - order.begin();
+                order.erase(it);
+                if (j < want) {
+                    want--;
+                }
+            }
+            order.insert(order.begin() + want, src);
+        }
+        pos = want;
+
+        // the weights that come next, one for each other slot, keep the slots they are read into
+        const size_t n_next = std::min(slots.size() - 1, order.size() - 1);
+        std::vector<const ggml_tensor *> next(n_next);
+        for (size_t k = 0; k < n_next; ++k) {
+            next[k] = order[(pos + 1 + k) % order.size()];
+        }
+
+        const auto t_start = ggml_time_us();
+        slot & s = take(src, next);
+
+        // read now what the upload needs that is not in the slot yet: whole experts, and the parts of experts that pad
+        const size_t expert_size = src->nb[2];
+        std::vector<uint8_t> & used = last[src];
+        used.assign(src->ne[2], 0);
+        reads.clear();
+        size_t bytes = 0;
+        for (const llama_moe_upload & u : ups) {
+            for (size_t o = u.offset; o < u.offset + u.size; ) {
+                const size_t e     = o/expert_size;
+                const size_t begin = e*expert_size;
+                const size_t end   = std::min(begin + expert_size, u.offset + u.size);
+                const bool   whole = o == begin && end == begin + expert_size;
+                used[e] |= whole;
+                if (!s.staged[e]) {
+                    s.staged[e] = whole;
+                    if (!reads.empty() && reads.back().src + reads.back().size == (const uint8_t *) src->data + o) {
+                        reads.back().size += end - o;
+                    } else {
+                        reads.push_back({ (const uint8_t *) src->data + o, end - o, s.at(o) });
+                    }
+                    bytes += end - o;
+                }
+                o = end;
+            }
+        }
+        for (const llama_moe_cached & c : cached) {
+            std::fill(used.begin() + c.expert, used.begin() + c.expert + c.n, 1);
+        }
+        reader.read_now(reads, true);
+        wait(s);
+        st.read_now += bytes;
+        const auto t_copy = ggml_time_us();
+        st.wait_ms += (t_copy - t_start)/1000.0;
+
+        // the device is idle, so the host can write dst: the scheduler waits for it before every copy of an input with
+        // a single device, which this does again for the others
+        ggml_backend_synchronize(backend);
+        fns.clear();
+        for (const llama_moe_upload & u : ups) {
+            for (size_t o = 0; o < u.size; o += chunk) {
+                const size_t n = std::min(chunk, u.size - o);
+                const uint8_t * p = s.at(u.offset + o);
+                const size_t  off = u.offset + o;
+                fns.push_back([dst, p, off, n] { ggml_backend_tensor_set(dst, p, off, n); });
+            }
+            st.copied += u.size;
+        }
+        // and the experts in the cache from its banks, which large batches only read
+        if (!ctx_views || n_views < 2*cached.size()) {
+            n_views = 2*std::max(cached.size(), (size_t) src->ne[2]);
+            ggml_init_params params = { n_views*ggml_tensor_overhead(), nullptr, true };
+            ctx_views.reset(ggml_init(params));
+        }
+        ggml_reset(ctx_views.get());
+        for (const llama_moe_cached & c : cached) {
+            ggml_tensor * sv = ggml_view_3d(ctx_views.get(), c.bank, c.bank->ne[0], c.bank->ne[1], c.n, c.bank->nb[1], c.bank->nb[2], c.slot*c.bank->nb[2]);
+            ggml_tensor * dv = ggml_view_3d(ctx_views.get(), dst, dst->ne[0], dst->ne[1], c.n, dst->nb[1], dst->nb[2], c.expert*dst->nb[2]);
+            ggml_backend_view_init(sv);
+            ggml_backend_view_init(dv);
+            fns.push_back([sv, dv] { ggml_backend_tensor_copy(sv, dv); });
+            st.copied += ggml_nbytes(sv);
+            st.cached += ggml_nbytes(sv);
+        }
+        copier.run_now(fns);
+        st.copy_ms += (ggml_time_us() - t_copy)/1000.0;
+        st.n_uploads++;
+        s.used = ++clock;
+
+        // and the weights that come next are read while the device computes this one
+        if (ahead) {
+            for (size_t k = 0; k < n_next; ++k) {
+                read_ahead(backend, take(next[k], next));
+            }
+        }
+    }
+};
