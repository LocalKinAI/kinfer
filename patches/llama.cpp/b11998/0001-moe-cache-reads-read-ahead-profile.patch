+        if (threads.empty()) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(mutex);
+        jobs.erase(std::remove_if(jobs.begin(), jobs.end(), [](const job & j) { return !j.now; }), jobs.end());
