+        std::vector<job> js;
+        split(reads, false, nocache, js);
+        if (threads.empty()) {
+            std::vector<uint8_t> scratch;
+            for (const job & j : js) {
+                exec(j, scratch);
+                done();
+            }
+            return js.size();
+        }
+        std::lock_guard<std::mutex> lock(mutex);
+        for (job & j : js) {
+            j.done = done;
+            jobs.push_back(std::move(j));
+        }
+        cv_job.notify_all();
+        return js.size();
+    }
+
+    // run fns with every thread, ahead of everything queued, and wait for them
+    void run_now(std::vector<std::function<void()>> & fns) {
+        if (fns.empty()) {
+            return;
+        }
+        if (threads.empty()) {
+            for (auto & fn : fns) {
+                fn();
+            }
+            return;
+        }
+        std::unique_lock<std::mutex> lock(mutex);
+        for (auto it = fns.rbegin(); it != fns.rend(); ++it) {
