+// reads host experts into host memory with a pool of threads, in requests of up to chunk bytes, ahead of anything
+// queued to be read ahead; experts guessed for the next layer are read into the page cache while the device computes
+struct moe_cache_reader {
+    static constexpr size_t chunk = 2*1024*1024;
+    static constexpr size_t page  = 4096;
+
+    struct read {
+        const uint8_t * src;
+        size_t          size;
+        uint8_t       * dst; // nullptr: into the page cache only, for a later read of src
+    };
+
+    struct job {
+        read     r;
+        int      fd;  // -1: copied from the mapping
+        uint64_t off; // in the file
+        bool     now;
+        std::function<void()> fn;   // runs instead of a read
+        std::function<void()> done; // runs after the read
+    };
+
+    std::vector<std::thread> threads;
+    std::mutex mutex;
+    std::condition_variable cv_job;
+    std::condition_variable cv_done;
+    std::deque<job> jobs; // jobs for now at the front
+    size_t n_now = 0;     // jobs for now queued or running
+    bool stop = false;
+
+    void start(int n_threads) {
+        for (int i = 0; i < n_threads; ++i) {
+            threads.emplace_back([this] { run(); });
+        }
+    }
+
+    void shutdown() {
+        if (threads.empty()) {
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stop = true;
+        }
+        cv_job.notify_all();
+        for (auto & t : threads) {
+            t.join();
+        }
+        threads.clear();
+    }
+
+    ~moe_cache_reader() {
+        shutdown();
+    }
+
+    // start paging in memory that is not read from a file, without waiting for it
+    static void advise(const uint8_t * data, size_t size) {
+#ifndef _WIN32
+        static const uintptr_t pg = (uintptr_t) sysconf(_SC_PAGESIZE);
+        const uintptr_t begin = (uintptr_t) data & ~(pg - 1);
+        const uintptr_t end   = (uintptr_t) data + size;
+        if (end > begin) {
+            madvise((void *) begin, end - begin, MADV_WILLNEED);
+        }
+#else
+        GGML_UNUSED(data);
+        GGML_UNUSED(size);
+#endif
+    }
+
+    static void touch(const uint8_t * data, size_t size) {
+        const volatile uint8_t * p = data;
+        uint8_t sum = 0;
+        for (size_t o = 0; o < size; o += page) {
+            sum += p[o];
+        }
+        if (size > 0) {
+            sum += p[size - 1];
+        }
+        (void) sum;
+    }
+
+    static void exec(const job & j, std::vector<uint8_t> & scratch) {
+#ifndef _WIN32
+        if (j.fd >= 0) {
+            uint8_t * dst = j.r.dst;
+            if (dst == nullptr) {
+                scratch.resize(chunk);
+                dst = scratch.data();
+            }
+            size_t done = 0;
+            while (done < j.r.size) {
+                const ssize_t n = pread(j.fd, dst + done, j.r.size - done, (off_t) (j.off + done));
+                if (n > 0) {
+                    done += (size_t) n;
+                } else if (n < 0 && errno == EINTR) {
+                    continue;
+                } else {
+                    break;
+                }
+            }
+            if (done == j.r.size) {
+                return;
+            }
+            // a failed read is copied from the mapping instead
+        }
+#endif
+        if (j.r.dst != nullptr) {
+            std::memcpy(j.r.dst, j.r.src, j.r.size);
+        } else {
+            touch(j.r.src, j.r.size);
+        }
+    }
+
+    void run() {
+        std::vector<uint8_t> scratch;
+        std::unique_lock<std::mutex> lock(mutex);
+        while (true) {
+            cv_job.wait(lock, [&] { return stop || !jobs.empty(); });
+            if (stop) {
+                return;
+            }
+            job j = std::move(jobs.front());
+            jobs.pop_front();
+            lock.unlock();
+            if (j.fn) {
+                j.fn();
+            } else {
+                exec(j, scratch);
+                if (j.done) {
+                    j.done();
+                }
+            }
+            lock.lock();
+            if (j.now && --n_now == 0) {
+                cv_done.notify_all();
+            }
+        }
+    }
+
+    // requests end at multiples of chunk in the file, so the requests of a large read are aligned
+    static void split(const std::vector<read> & reads, bool now, bool nocache, std::vector<job> & out) {
+        moe_cache_files & files = moe_cache_files::get();
+        moe_cache_files::region reg; // the last one found, likely the region of the next read too
+        for (const read & r : reads) {
+            for (size_t o = 0; o < r.size; ) {
+                const uint8_t * src = r.src + o;
+                if ((uintptr_t) src < reg.begin || (uintptr_t) src >= reg.end) {
+                    reg = files.find(src, r.size - o);
+                }
