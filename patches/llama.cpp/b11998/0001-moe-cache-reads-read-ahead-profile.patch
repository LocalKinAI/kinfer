 namespace {
 
+// the files host experts are mapped from
+// a copy from memory mapped from a file pages it in one fault at a time, about 1.5 GB/s with sixteen threads faulting,
+// while the SSD of a MacBook Pro reads 13 GB/s given requests of a few MB from a few threads; so experts are read from
+// the file with pread when the mapping can be traced back to it, and copied from the mapping when it cannot
+struct moe_cache_files {
+    struct region {
+        uintptr_t begin      = 0;
+        uintptr_t end        = 0;
+        uint64_t  off        = 0;  // offset in the file of begin
+        int       fd         = -1; // -1 if the region is not mapped from a file that reads back what is mapped
+        int       fd_nocache = -1; // the same file, read past the page cache
+    };
+
+    std::mutex mutex;
+    std::vector<region> regions; // sorted by begin
+    std::unordered_map<std::string, std::pair<int, int>> fds;
+
+    // shared by every context and never freed, like the files it keeps open
+    static moe_cache_files & get() {
+        static moe_cache_files * res = new moe_cache_files();
+        return *res;
+    }
+
+    // the region of p, or one of size bytes that is not read from a file if p is in none
+    region find(const void * p, size_t size) {
+        const uintptr_t a = (uintptr_t) p;
+        auto after = [](uintptr_t v, const region & r) { return v < r.begin; };
+        std::lock_guard<std::mutex> lock(mutex);
+        auto it = std::upper_bound(regions.begin(), regions.end(), a, after);
+        if (it != regions.begin() && a < std::prev(it)->end) {
+            return *std::prev(it);
+        }
+        region r;
+        if (!lookup(p, r)) {
+            r = {};
+            r.begin = a;
+            r.end   = a + size;
+            return r;
+        }
+        regions.insert(std::upper_bound(regions.begin(), regions.end(), r.begin, after), r);
+        return r;
+    }
+
+private:
+    bool lookup(const void * p, region & r) {
+#if defined(__APPLE__)
+        mach_vm_address_t addr = (mach_vm_address_t) (uintptr_t) p;
+        mach_vm_size_t    size = 0;
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t count  = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t            object = MACH_PORT_NULL;
+        if (mach_vm_region(mach_task_self(), &addr, &size, VM_REGION_BASIC_INFO_64, (vm_region_info_t) &info, &count, &object) != KERN_SUCCESS ||
+                addr > (mach_vm_address_t) (uintptr_t) p) {
+            return false;
+        }
+        r.begin = (uintptr_t) addr;
+        r.end   = (uintptr_t) (addr + size);
+
+        char path[PROC_PIDPATHINFO_MAXSIZE];
+        if (proc_regionfilename(getpid(), (uint64_t) (uintptr_t) p, path, sizeof(path)) <= 0) {
+            return true; // not mapped from a file
+        }
+        auto it = fds.find(path);
+        if (it == fds.end()) {
+            const int fd = open(path, O_RDONLY | O_CLOEXEC);
+            int fd_nocache = open(path, O_RDONLY | O_CLOEXEC);
+            if (fd_nocache >= 0 && fcntl(fd_nocache, F_NOCACHE, 1) != 0) {
+                close(fd_nocache);
+                fd_nocache = -1;
+            }
+            it = fds.emplace(path, std::make_pair(fd, fd_nocache >= 0 ? fd_nocache : fd)).first;
+        }
+        if (it->second.first < 0) {
+            return true;
+        }
+
+        // the file must still hold what is mapped
+        uint8_t buf[256];
+        const size_t   n   = std::min<size_t>(sizeof(buf), r.end - (uintptr_t) p);
+        const uint64_t off = info.offset + ((uintptr_t) p - r.begin);
+        if (pread(it->second.first, buf, n, (off_t) off) != (ssize_t) n || std::memcmp(buf, p, n) != 0) {
+            return true;
+        }
+        r.off        = info.offset;
+        r.fd         = it->second.first;
+        r.fd_nocache = it->second.second;
+        return true;
+#else
+        GGML_UNUSED(p);
+        GGML_UNUSED(r);
+        return false;
+#endif
+    }
+};
