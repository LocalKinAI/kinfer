+    std::vector<std::thread> threads;
+    std::mutex mutex;
+    std::condition_variable cv_job;
+    std::condition_variable cv_done;
+    std::deque<job> jobs; // jobs for now at the front
+    size_t n_now = 0;     // jobs for now queued or running
+    bool stop = false;
+
+    void start(int n_threads) {
+        for (int i = 0; i < n_threads; ++i) {
+            threads.emplace_back([this] { run(); });
+        }
+    }
+
+    void shutdown() {
+        if (threads.empty()) {
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stop = true;
+        }
+        cv_job.notify_all();
+        for (auto & t : threads) {
+            t.join();
+        }
+        threads.clear();
+    }
+
+    ~moe_cache_reader() {
+        shutdown();
+    }
+
+    // start reading the pages of r without waiting for them
+    static void advise(const range & r) {
+#ifndef _WIN32
+        static const uintptr_t pg = (uintptr_t) sysconf(_SC_PAGESIZE);
+        const uintptr_t begin = (uintptr_t) r.data & ~(pg - 1);
+        const uintptr_t end   = (uintptr_t) r.data + r.size;
+        if (end > begin) {
+            madvise((void *) begin, end - begin, MADV_WILLNEED);
+        }
+#else
+        GGML_UNUSED(r);
+#endif
+    }
+
+    static void touch(const range & r) {
+        const volatile uint8_t * p = r.data;
+        uint8_t sum = 0;
+        for (size_t o = 0; o < r.size; o += page) {
+            sum += p[o];
+        }
+        if (r.size > 0) {
+            sum += p[r.size - 1];
+        }
+        (void) sum;
+    }
+
+    void run() {
+        std::unique_lock<std::mutex> lock(mutex);
+        while (true) {
+            cv_job.wait(lock, [&] { return stop || !jobs.empty(); });
+            if (stop) {
+                return;
+            }
+            job j = std::move(jobs.front());
+            jobs.pop_front();
+            lock.unlock();
+            if (j.fn) {
+                j.fn();
+            } else {
+                touch(j.r);
+            }
+            lock.lock();
+            if (j.now && --n_now == 0) {
+                cv_done.notify_all();
+            }
+        }
+    }
+
+    static void split(const std::vector<range> & ranges, bool now, std::vector<job> & out) {
+        for (const range & r : ranges) {
+            for (size_t o = 0; o < r.size; o += chunk) {
+                out.push_back({ { r.data + o, std::min(chunk, r.size - o) }, now, nullptr });
+            }
+        }
+    }
+
+    // read the ranges with every thread, ahead of anything queued to be read ahead, and wait for them
+    void read_now(const std::vector<range> & ranges) {
+        for (const range & r : ranges) {
+            advise(r);
+        }
+        if (threads.empty()) {
+            for (const range & r : ranges) {
+                touch(r);
+            }
+            return;
+        }
+        std::vector<job> js;
+        split(ranges, true, js);
+        if (js.empty()) {
+            return;
+        }
+        std::unique_lock<std::mutex> lock(mutex);
+        jobs.insert(jobs.begin(), js.begin(), js.end());
+        n_now += js.size();
+        cv_job.notify_all();
+        cv_done.wait(lock, [&] { return n_now == 0; });
+    }
+
+    // drop what is still queued to be read ahead, it was for a layer that has started, and run fn on a thread
+    void ahead(std::function<void()> fn) {
+        if (threads.empty()) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(mutex);
+        jobs.erase(std::remove_if(jobs.begin(), jobs.end(), [](const job & j) { return !j.now; }), jobs.end());
+        jobs.push_back({ { nullptr, 0 }, false, std::move(fn) });
+        cv_job.notify_one();
+    }
+
+    // ask for the ranges to be read, without waiting for them
+    void ahead(const std::vector<range> & ranges) {
+        for (const range & r : ranges) {
+            advise(r);
+        }
+    }
