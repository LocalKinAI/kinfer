+    bool save_profile(const char * path) {
+        if (counts.empty()) {
+            return false;
+        }
+        // nothing generated since the last save: leave the file as it is rather than halving it
+        if (std::all_of(counts.begin(), counts.end(), [](float c) { return c == 0.0f; })) {
+            return true;
+        }
+        std::vector<float> merged = counts;
+        std::vector<float> old;
+        if (read_profile(path, old)) {
+            for (size_t i = 0; i < merged.size(); ++i) {
+                merged[i] += 0.5f*old[i];
+            }
+        }
+        const std::string tmp = std::string(path) + ".tmp";
+        FILE * f = std::fopen(tmp.c_str(), "wb");
+        if (f == nullptr) {
+            return false;
+        }
+        const uint32_t n_layer  = layers.size();
+        const uint32_t n_expert = n_expert_model;
+        bool ok = std::fwrite(profile_magic, 1, sizeof(profile_magic), f) == sizeof(profile_magic) &&
+            std::fwrite(&n_layer, sizeof(n_layer), 1, f) == 1 && std::fwrite(&n_expert, sizeof(n_expert), 1, f) == 1 &&
+            std::fwrite(merged.data(), sizeof(float), merged.size(), f) == merged.size();
+        ok = std::fclose(f) == 0 && ok;
+        if (!ok || std::rename(tmp.c_str(), path) != 0) {
+            std::remove(tmp.c_str());
+            return false;
+        }
+        std::fill(counts.begin(), counts.end(), 0.0f);
+        return true;
+    }
+
+    bool load_profile(const char * path) {
+        if (groups.empty() || counts.empty()) {
+            return false;
+        }
+        std::vector<float> prof;
+        if (!read_profile(path, prof)) {
+            return false;
+        }
+        const auto t_start = std::chrono::steady_clock::now();
+
+        struct item {
+            float   count;
+            int32_t il;
+            int32_t e;
+        };
+        size_t n_loaded = 0;
+        double loaded = 0.0;
+        double total  = 0.0;
+        for (group & g : groups) {
+            const int32_t n_expert = g.ref[0]->ne[2];
+            if (g.n_slots == 0 || n_expert != n_expert_model) {
+                continue;
+            }
+            std::vector<item> items;
+            for (int32_t il : g.layers) {
+                for (int32_t e = 0; e < n_expert; ++e) {
+                    const float c = prof[(size_t) il*n_expert + e];
+                    total += c;
+                    if (c > 0.0f) {
+                        items.push_back({ c, il, e });
+                    }
+                }
+            }
+            std::sort(items.begin(), items.end(), [](const item & a, const item & b) { return a.count > b.count; });
+            const int32_t n = std::min<int32_t>(g.n_slots, (int32_t) items.size());
+
+            // start the group over: the most used experts in the first slots, the protected half of the SLRU
+            // holding the top of the profile and the empty slots first in line to be filled
+            g.slru.init(layers.size(), n_expert, g.n_slots);
+            for (int32_t il : g.layers) {
+                int32_t * slot_map = (int32_t *) layers[il].slot_map->data;
+                std::fill(slot_map, slot_map + n_expert, -1);
+                g.slru.slot_map[il] = slot_map;
+            }
+            for (int32_t s = 0; s < n; ++s) {
+                g.slru.key_of[s] = items[s].il*n_expert + items[s].e;
+                g.slru.slot_map[items[s].il][items[s].e] = s;
+                loaded += items[s].count;
+            }
+            for (int32_t s = n; s < g.n_slots; ++s) {
+                g.slru.move(s, false);
+            }
+            for (int32_t s = n - 1; s >= 0; --s) {
+                g.slru.move(s, s < g.n_slots/2);
+            }
+
+            // in batches, each read and copied before the next: read all at once, the first experts would be evicted
+            // again before they are copied when the cache is larger than the memory the page cache has left
+            constexpr size_t batch = 512u*1024*1024;
+            for (int32_t s0 = 0; s0 < n; ) {
+                ranges.clear();
+                size_t bytes = 0;
+                int32_t s1 = s0;
+                for (; s1 < n && bytes < batch; ++s1) {
+                    for (const ggml_tensor * w : layers[items[s1].il].experts) {
+                        ranges.push_back({ (const uint8_t *) w->data + (size_t) items[s1].e*w->nb[2], w->nb[2] });
+                        bytes += w->nb[2];
+                    }
+                }
+                reader.read_now(ranges);
+                for (int32_t s = s0; s < s1; ++s) {
+                    const layer & l = layers[items[s].il];
+                    for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+                        const ggml_tensor * w = l.experts[ip];
+                        ggml_backend_tensor_set(g.banks[ip], (const uint8_t *) w->data + (size_t) items[s].e*w->nb[2], (size_t) s*w->nb[2], w->nb[2]);
+                    }
+                }
+                s0 = s1;
+            }
+            n_loaded += n;
+        }
+        LLAMA_LOG_INFO("llama_moe_cache: profile %s placed %zu experts in the cache in %.1f s, %.1f%% of the selections it counts\n",
+            path, n_loaded, std::chrono::duration<double>(std::chrono::steady_clock::now() - t_start).count(),
+            total > 0.0 ? 100.0*loaded/total : 0.0);
+        return n_loaded > 0;
+    }
