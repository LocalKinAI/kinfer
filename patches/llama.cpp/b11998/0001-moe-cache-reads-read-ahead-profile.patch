+void llama_moe_cache_read(const std::vector<std::pair<const void *, size_t>> & ranges) {
+    // shared by every context and never freed: it holds no state of theirs, and threads still waiting at exit are harmless
+    static moe_cache_reader * reader = [] {
+        auto * r = new moe_cache_reader();
+        r->start(std::clamp((int) std::thread::hardware_concurrency(), 4, 16));
+        return r;
+    }();
+    std::vector<moe_cache_reader::range> rs;
+    rs.reserve(ranges.size());
+    for (const auto & [data, size] : ranges) {
+        rs.push_back({ (const uint8_t *) data, size });
+    }
+    reader->read_now(rs);
+}
