+llama_moe_stream::llama_moe_stream(const llama_moe_cache * cache, const std::vector<const ggml_tensor *> & weights, int n_slots) {
+    size_t max_weight = 0;
+    for (const ggml_tensor * w : weights) {
+        max_weight = std::max(max_weight, ggml_nbytes(w));
+    }
+    pimpl.reset(new impl(cache, weights, max_weight, n_slots));
