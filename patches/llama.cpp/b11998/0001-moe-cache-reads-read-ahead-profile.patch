+// where in host memory to read size bytes from src: at the same offset within a 16 KiB page, which is the offset the
+// file has them at, so the aligned middle of a large read can go straight from the SSD into it
+static size_t moe_cache_place(size_t & used, const void * src, size_t size) {
+    constexpr size_t align = 16384;
+    const size_t o = used + ((uintptr_t) src % align + align - used % align) % align;
+    used = o + size;
+    return o;
+}
+
+// host memory of at least size bytes, aligned to 16 KiB
+static uint8_t * moe_cache_stage(std::vector<uint8_t> & buf, size_t size) {
+    constexpr size_t align = 16384;
+    if (buf.size() < size + align) {
+        std::vector<uint8_t>().swap(buf);
+        buf.resize(size + align);
+    }
+    return (uint8_t *) (((uintptr_t) buf.data() + align - 1) & ~(uintptr_t) (align - 1));
+}
