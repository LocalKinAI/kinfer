+// A peer that died without closing the connection — its FIN lost, its machine asleep or unplugged — would
+// hold the server's one connection, or leave the client waiting, until TCP's own keepalive two hours later.
+// Probing after 10 s of silence, every 5 s, 3 times, finds it within about 25 s; the peer's kernel answers
+// the probes, so a long computation on a live peer is not mistaken for a dead one.
+static void set_keep_alive(sockfd_t sockfd) {
+    int on = 1;
+    setsockopt(sockfd, SOL_SOCKET, SO_KEEPALIVE, (char *)&on, sizeof(on));
+#if defined(__APPLE__)
+    int idle = 10, intvl = 5, cnt = 3;
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPALIVE, &idle, sizeof(idle));
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof(intvl));
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof(cnt));
+#elif defined(__linux__)
+    int idle = 10, intvl = 5, cnt = 3;
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPIDLE, &idle, sizeof(idle));
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof(intvl));
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof(cnt));
+#endif
+}
