+// A server serves one client at a time, and the client connects afresh whenever nothing holds its last
+// connection, several times while a model loads. Between two of them the server can refuse or reset the next
+// for a moment while it turns from the last: over a Thunderbolt cable, 6 of 300 connections opened right after
+// the last one closed were reset. A refused or reset connection is tried again for about two seconds; a server
+// that is gone still fails, and one turning around does not abort the load.
+static bool connect_failed_for_now() {
+#ifdef _WIN32
+    const int err = WSAGetLastError();
+    return err == WSAECONNREFUSED || err == WSAECONNRESET;
+#else
+    return errno == ECONNREFUSED || errno == ECONNRESET;
+#endif
+}
